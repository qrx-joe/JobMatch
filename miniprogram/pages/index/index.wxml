<!-- 首页 -->
<view class="container">
  <!-- 顶部欢迎 -->
  <view class="header">
    <view class="greeting">你好，选岗助手</view>
    <view class="subtitle">智能匹配，冲刺上岸</view>
  </view>

  <!-- 平台选择 -->
  <view class="section">
    <view class="section-title">选择考试类型</view>
    <view class="platforms">
      <view
        wx:for="{{platforms}}"
        wx:key="id"
        class="platform-item {{selectedPlatform === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPlatform"
      >
        <view class="platform-icon" style="background-color: {{item.color}}">
          <text>{{item.name}}</text>
        </view>
        <view class="platform-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 快捷筛选 -->
  <view class="section">
    <view class="section-title">快捷筛选</view>
    <view class="quick-filters">
      <view class="quick-filter-item" data-type="fresh" bindtap="quickFilter">
        <text class="icon">🎓</text>
        <text>应届生</text>
      </view>
      <view class="quick-filter-item" data-type="party" bindtap="quickFilter">
        <text class="icon">🏆</text>
        <text>党员</text>
      </view>
      <view class="quick-filter-item" data-type="under30" bindtap="quickFilter">
        <text class="icon">👤</text>
        <text>30岁以下</text>
      </view>
    </view>
  </view>

  <!-- 热门城市 -->
  <view class="section">
    <view class="section-title">热门地市</view>
    <view class="hot-cities">
      <view
        wx:for="{{hotCities}}"
        wx:key="*this"
        class="city-tag"
        data-city="{{item}}"
        bindtap="searchByCity"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 公告列表 -->
  <view class="section">
    <view class="section-title">最新公告</view>
    <view class="news-list">
      <view
        wx:for="{{newsList}}"
        wx:key="*this"
        class="news-item"
        bindtap="viewNews"
      >
        <view class="news-title">{{item.title}}</view>
        <view class="news-date">{{item.date}}</view>
      </view>
    </view>
  </view>

  <!-- 开始筛选按钮 -->
  <view class="bottom-action">
    <button class="primary-btn" bindtap="goToFilter" type="primary">
      开始智能筛选
    </button>
  </view>
</view>

<style>
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.greeting {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.section {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #333;
}

.platforms {
  display: flex;
  justify-content: space-between;
}

.platform-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.platform-item.active .platform-icon {
  transform: scale(1.1);
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.3);
}

.platform-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}

.platform-name {
  font-size: 26rpx;
  color: #666;
}

.quick-filters {
  display: flex;
  gap: 20rpx;
}

.quick-filter-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.quick-filter-item .icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.quick-filter-item text:last-child {
  font-size: 26rpx;
  color: #666;
}

.hot-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.city-tag {
  padding: 16rpx 28rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.news-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.news-item:last-child {
  border-bottom: none;
}

.news-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.news-date {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}
</style>